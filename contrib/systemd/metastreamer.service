[Unit]
Description=metastreamer: goggles over USB -> HDMI and HTTP (fMP4 live, HLS)
DefaultDependencies=no
After=sys-kernel-config.mount
Conflicts=shutdown.target
Before=shutdown.target

[Service]
# builds the USB gadget itself (configfs + FunctionFS); it leaves the bus when the process exits
ExecStartPre=-/sbin/modprobe libcomposite
ExecStart=/usr/local/bin/metastreamer
Restart=always
RestartSec=1

[Install]
WantedBy=sysinit.target
