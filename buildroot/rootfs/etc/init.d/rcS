#!/bin/sh
# Start all init scripts in /etc/init.d in numerical order. The boot screen is metastreamer --splash on the
# console framebuffer (the same look as the status screen that follows): it reads the progress from
# /run/boot.step ("DONE TOTAL WHAT"), and metastreamer stops it when it takes the display.
# The scripts' own output goes to /run/boot.log, with the uptime each one started at; a failed script is marked
# there with FAILED. The USB controller driver is loaded in the background by inittab, before this script.

LOG=/run/boot.log
STEP=/run/boot.step

label() {
	case "${1#*/S??}" in
	clock) echo "SETTING THE CLOCK" ;;
	syslogd) echo "STARTING THE SYSTEM LOG" ;;
	klogd) echo "STARTING THE KERNEL LOG" ;;
	sysctl) echo "APPLYING KERNEL SETTINGS" ;;
	watchdog) echo "STARTING THE WATCHDOG" ;;
	metastreamer) echo "STARTING METASTREAMER" ;;
	wifi) echo "STARTING WI-FI" ;;
	network) echo "STARTING THE NETWORK" ;;
	sshd) echo "STARTING SSH" ;;
	*) echo "STARTING ${1#*/S??}" | tr a-z A-Z ;;
	esac
}

set -- /etc/init.d/S??*
total=$#
done=0

echo "0 $total STARTING THE SYSTEM" > $STEP
/usr/bin/metastreamer --splash > /run/splash.log 2>&1 &
echo $! > /run/splash.pid

for i in "$@"; do
	[ -f "$i" ] || continue   # dangling symlink
	echo "$done $total $(label "$i")" > $STEP
	read up rest < /proc/uptime   # a shell builtin: no process
	echo "=== $up $i" >> $LOG
	case "$i" in
		*.sh) ( trap - INT QUIT TSTP; set start; . "$i" ) >> $LOG 2>&1 ;;
		*) "$i" start >> $LOG 2>&1 ;;
	esac
	[ $? -eq 0 ] || echo "=== FAILED: $i" >> $LOG
	done=$((done + 1))
done
echo "$done $total READY" > $STEP
read up rest < /proc/uptime
echo "=== $up done" >> $LOG
