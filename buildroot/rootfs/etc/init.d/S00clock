#!/bin/sh
# No real-time clock on the Pi: start from the image build time instead of 1970.
# Later the goggles' clock (if newer) and then NTP over Wi-Fi correct it.
case "$1" in
start)
	# no clock at boot: always behind the build time. read is a shell builtin: date is the only process here
	read b < /etc/build-time 2>/dev/null
	[ -n "$b" ] && date -u -s "@$b" >/dev/null
	;;
esac
